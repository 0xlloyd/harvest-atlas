{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xlloyd/harvest-atlas/main/schema/common.schema.json",
  "$defs": {
    "regionCode": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" },
    "produceId": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "sourceId": { "type": "string", "pattern": "^[a-z]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "months": {
      "type": "array",
      "items": { "$ref": "#/$defs/month" },
      "uniqueItems": true,
      "minItems": 1
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "locale": { "type": "string", "enum": ["en-GB", "en-US", "en-AU", "fr-FR"] }
  }
}
